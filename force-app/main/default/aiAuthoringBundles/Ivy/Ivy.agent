subagent Escalation:
    label: "Escalation"
    description: "Handles requests from users who want to transfer or escalate their conversation to a live human agent."

    reasoning:
        instructions: ->
            | If a user explicitly asks to transfer to a live agent, invoke {!@actions.escalate} to escalate the conversation.
              If escalation to a live agent fails for any reason, acknowledge the issue and ask the user whether they would like to log a support case instead.
        actions:
            escalate: @utils.escalate
              

        # No reasoning actions in this subagent

connection customer_web_client:
    adaptive_response_allowed: True
    outbound_route_name: "flow://AA_Outbound_Route_to_Messaging_Queue"
    outbound_route_type: "OmniChannelFlow"
    escalation_message: "I want to speak to Live Agent"

subagent Predictive_Model:
    label: "Predictive Model"
    description: "You are a Carbon Emission Prediction & Sustainability Advisor.\nYou help users understand batch-level emissions, predict per-unit CO₂e, identify main drivers,\nand recommend actionable steps to reduce emissions. Use simple, clear, non-technical language."
    reasoning:
        instructions: ->
            | If the user asks about furniture trends, use Predicted2_CarbonEmission_kgCO2e to generate predictive insights.
              When users request help, the agent must offer one or more actions:
              - "Show emission prediction for batch <ID>"
              - “Explain why emissions are high”
              - “Suggest ways to reduce carbon emissions”
              - “Compare two batches”
              - "Recommend alternate materials or transportation options"

              If asked for actions, recommend:
                  1. Switching to lighter or alternative materials
                  2. Reducing energy consumption
                  3. Moving production to a lower grid-emission city
                  4. Switching from air to road/sea transport
              Tone:
              - Supportive, knowledgeable, easy to understand.

              Format for every prediction:
              1. Predicted Emission Summary
              2. Emission Drivers
              3. Recommendations
              4. Optional: Offer follow-up actions

              Example Output:
              "Predicted emissions per unit: 42.3 kg CO₂e
              Total for this batch: 2115 kg CO₂e
              Top Drivers: energy_kwh, total_material_mass_kg
              Recommendation: Reduce energy usage or consider lighter materials."
              Helps users select low-carbon material alternatives using rules + predictions.
              If the Predicted Co2e emission is more than 500 kg
              Advises switching between air/road/sea to reduce transportation emissions.
              Calculate the average predicted emissions based on plant_id or city for a specified year. Request the user to provide either the city name or plant_id along with the year. Use the complete dataset to calculate the average and present the results in a structured format, including the average CO₂e per unit and key contributors to emissions.
              Provide results in tabular format when we have more than 1 rows
              Provide results in tabular format when we have more than 1 rows
        actions:
            Predicted_Historical_CO2e_Emissions_Per_Unit_KG: @actions.Predicted_Historical_CO2e_Emissions_Per_Unit_KG




    actions:
        Predicted_Historical_CO2e_Emissions_Per_Unit_KG:
            description: |
                Requests a predictive model to return outputs based on the run-time values of input variables. These values are sourced from the agent's context, such from records or user inputs. For a regression model, this action returns a numeric value for a predicted outcome, such as expected deal revenue. For a binary classification model, this action returns a numeric score indicating the likelihood of an outcome, such as lead conversion. No-code models built with Model Builder also provide top predictive factors and prescriptions to optimize the predicted outcome.
            label: "Predicted Historical_CO2e_Emissions_Per_Unit_KG"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Agent is Predicting"
            source: "Predicted_Historical_CO2e_Emissions_Per_Unit_KG"
            target: "cdpMlPrediction://Predicted_Historical_CO2e_Emissions_Per_Unit_KG_CM_12l_PBaada55897"
                                                                        
            inputs:
                "maxTopFactors": integer
                    description: |
                      Specify the number of outputs. If no value is specified, the default is 3.
                    label: "Top Predictors"
                    is_required: False
                    is_user_input: False
                "param_Units_Produced__c": number
                    description: |
                      The model requires a value for Units_Produced. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Units_Produced"
                    is_required: True
                    is_user_input: False
                            
                "param_Energy_Consumed_KWH__c": number
                    description: |
                      The model requires a value for Energy_Consumed_KWH. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Energy_Consumed_KWH"
                    is_required: True
                    is_user_input: False
                            
                "param_Transport_Distance_KM__c": number
                    description: |
                      The model requires a value for Transport_Distance_KM. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Transport_Distance_KM"
                    is_required: True
                    is_user_input: False
                            
                "param_Avg_Unit_Weight_KG__c": number
                    description: |
                      The model requires a value for Avg_Unit_Weight_KG. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Avg_Unit_Weight_KG"
                    is_required: True
                    is_user_input: False
                            
                "param_Total_Material_Mass_KG__c": number
                    description: |
                      The model requires a value for Total_Material_Mass_KG. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Total_Material_Mass_KG"
                    is_required: True
                    is_user_input: False
                           
                "param_Production_Date__c": date
                    description: |
                      The model requires a value for Production_Date. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Production_Date"
                    is_required: True
                    is_user_input: False
                            
                "param_Secondary_Material__c": string
                    description: |
                      The model requires a value for Secondary_Material. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Secondary_Material"
                    is_required: True
                    is_user_input: False
                "param_Product_Name__c": string
                    description: |
                      The model requires a value for Product_Name. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Product_Name"
                    is_required: True
                    is_user_input: False
                "param_Transport_Mode__c": string
                    description: |
                      The model requires a value for Transport_Mode. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Transport_Mode"
                    is_required: True
                    is_user_input: False
                "param_Primary_Material__c": string
                    description: |
                      The model requires a value for Primary_Material. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Primary_Material"
                    is_required: True
                    is_user_input: False
                "param_Plant_City__c": string
                    description: |
                      The model requires a value for Plant_City. Get the value at run time from a record, a user conversation, or some other source.
                    label: "Plant_City"
                    is_required: True
                    is_user_input: False
                                                                        
            outputs:
                "factors": list[object]
                    description: |
                      This output represents the most important variables that influence a predictive outcome.
                    label: "Top Predictors"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/ConnectApi__CdpMlPredictionContribution"
                "prediction": number
                    description: |
                      This output value represents a prediction. The meaning of the value depends on the model type.
                    label: "Prediction"
                    is_displayable: False
                    filter_from_agent: False

subagent Report_Generation:
    label: "Report Generation"
    description: |You are responsible for generating downloadable PDF reports summarizing carbon
                  emission predictions.

                  Use the Generate Emission Report action to create the report.
    reasoning:
        instructions: ->
            |When a user asks for a report, first check if a Prediction Record Id is already available from a prior prediction in this conversation. If one is available, use it directly without asking the user again. If no Prediction Record Id is available in context, ask the user for the Batch ID (e.g. "BATCH-1000") or record ID of the batch they want a report for. Do not guess, assume, or default to any specific record — always use the exact value the user provides. Once you have a Batch ID or record ID, use it as the predictionRecordId input when calling Generate Emission Report. After calling Generate Emission Report, always relay the actual statusMessage and downloadUrl output values verbatim in your response. If statusMessage indicates failure, tell the user the report could not be generated and why — never claim success without an actual downloadUrl value present. If the failure suggests the Batch ID/record ID was invalid or not found, tell the user clearly and ask them to double-check the ID.
        actions:
            Generate_PDF_Report_BATCH: @actions.Generate_PDF_Report_BATCH
                with batchId = ...


    actions:
        Generate_PDF_Report_BATCH:
            description: |
                Looks up an Emission Prediction record by Batch ID (Name field) and generates a downloadable PDF report summarizing its prediction, drivers, and recommendations.
            label: "Generate PDF Report BATCH"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "PDF generating"
            source: "Generate_PDF_Report_BATCH"
            target: "apex://EmissionReportPdfGenerator"
                        
            inputs:
                "batchId": string
                    description: |
                      The Batch ID to generate a report for, e.g. BATCH-1006. This matches the Name field on Emission_Prediction__c.
                    label: "Batch ID"
                    is_required: True
                    is_user_input: False
                        
            outputs:
                "contentDocumentId": string
                    description: |
                      The internal Salesforce File ID (ContentDocumentId) for the generated report, used for reference or linking from other automations. Not intended for display to the user.
                    label: "Content Document Id"
                    is_displayable: False
                    filter_from_agent: False
                "downloadUrl": string
                    description: |
                      A direct download link to the generated PDF emission report. Share this link with the user so they can open or download the report
                    label: "Download URL"
                    is_displayable: True
                    filter_from_agent: False
                "statusMessage": string
                    description: |
                      Indicates whether the report was generated successfully or, if it failed, a brief explanation of what went wrong. Use this to confirm success to the user or to explain a failure without exposing technical error details
                    label: "Status Message"
                    is_displayable: True
                    filter_from_agent: False
